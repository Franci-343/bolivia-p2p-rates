[Unit]
Description=Bolivia P2P Rates Monitor Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bolivia-p2p-rates
ExecStart=/home/ubuntu/bolivia-p2p-rates/jre/bin/java -Xms64m -Xmx256m -XX:MaxMetaspaceSize=80m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -jar /home/ubuntu/bolivia-p2p-rates/bolivia-p2p-rates.jar

# Auto-recovery
Restart=always
RestartSec=5

# Environment Configuration
Environment=PORT=8080
Environment=POLL_INTERVAL_SECONDS=600
Environment=SQLITE_DB_PATH=database/rates.db
Environment=FIAT_CURRENCY=BOB
Environment=ASSET_CURRENCY=USDT

# Oracle Autonomous Database Sync Configuration (Always Free, Max 1 connection, 0 at rest)
Environment=ORACLE_SYNC_ENABLED=false
Environment=ORACLE_JDBC_URL=jdbc:oracle:thin:@francodb_low
Environment=ORACLE_DB_USER=BOLIVIA_P2P
Environment=ORACLE_DB_PASSWORD=
Environment=ORACLE_TNS_ADMIN=/home/ubuntu/.config/oracle_db/Wallet_FRANCODB
Environment=ORACLE_POOL_MAX_SIZE=1
Environment=ORACLE_SYNC_INTERVAL_SECONDS=60
Environment=ORACLE_SYNC_BATCH_SIZE=25
Environment=SQLITE_RECENT_SNAPSHOTS=100

# Hard memory protection for 1GB RAM VM
MemoryMax=450M

[Install]
WantedBy=multi-user.target
